{
  "manifest_version": 3,
  "name": "FB Helper",
  "version": "2.2.0",
  "description": "Facebook token, session cookies and ad account status. Requests go only to graph.facebook.com, with built-in rate limits.",
  "icons": {
    "16": "images/toolbar_16.png",
    "32": "images/toolbar_32.png",
    "48": "images/icon_48.png",
    "128": "images/icon_128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Helper",
    "default_icon": {
      "16": "images/toolbar_16.png",
      "32": "images/toolbar_32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://graph.facebook.com"
  },
  "minimum_chrome_version": "121"
}
